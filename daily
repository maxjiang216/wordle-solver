#!/usr/bin/env python3
"""
One command for daily play:
  1. fetches any missing past answers (up to yesterday, never today) from NYT's
     puzzle feed and appends them to data/wordle_answers.csv; asks if offline
  2. rebuilds weighted_three_solver if its source changed
  3. exports today's probabilities (model refit once a month, cached otherwise)
  4. picks the opener: cached if the prior is unchanged, else a warm search over
     yesterday's best openers (~3s; full ~15s search after the monthly refit)
  5. runs the interactive guide
  6. records today's answer when you solve it

Usage: ./daily            (run from anywhere)
       ./daily --opener sater   skip the opener search
"""

import argparse
import csv
import datetime as dt
import hashlib
import json
import os
import subprocess
import sys
import urllib.request

ROOT = os.path.dirname(os.path.abspath(__file__))
CSV = os.path.join(ROOT, 'data', 'wordle_answers.csv')
SOLVER = os.path.join(ROOT, 'weighted_three_solver')
SOURCE = os.path.join(ROOT, 'src', 'weighted_three_solver.cpp')
CACHE = os.path.join(ROOT, 'cache')
SOLVED = os.path.join(CACHE, 'solved_today.txt')
PRIOR = os.path.join(ROOT, 'data', 'prior_next.csv')
MODEL_CACHE = os.path.join(CACHE, 'prior_model.json')
OPENER_CACHE = os.path.join(CACHE, 'opener_today.json')
TOP_OPENERS = os.path.join(CACHE, 'top_openers.txt')
DAY0 = dt.date(2021, 6, 19)  # puzzle #0
# The feed NYT's own Wordle page loads. It also serves today's and future
# puzzles, so only ever request dates before today.
FEED = 'https://www.nytimes.com/svc/wordle/v2/{}.json'


def fetch_answer(date):
    """Official answer for a past date, or None if the fetch fails or looks wrong."""
    assert date < dt.date.today(), 'refusing to fetch today or later (spoiler)'
    try:
        req = urllib.request.Request(FEED.format(date), headers={'User-Agent': 'Mozilla/5.0'})
        d = json.load(urllib.request.urlopen(req, timeout=10))
    except Exception as e:  # network error, HTTP error, bad JSON
        print(f'    fetch failed for {date}: {e}')
        return None
    word = str(d.get('solution', '')).upper()
    if d.get('print_date') != str(date) or d.get('days_since_launch') != (date - DAY0).days or len(word) != 5:
        print(f'    unexpected feed data for {date}: {d}')
        return None
    return word


def append_answer(date, word):
    with open(CSV, 'rb+') as f:  # make sure the file ends with a newline
        f.seek(0, 2)
        if f.tell():
            f.seek(-1, 2)
            if f.read(1) != b'\n':
                f.write(b'\n')
    with open(CSV, 'a') as f:
        f.write(f'{date},{(date - DAY0).days},{word.upper()}\n')


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument('--opener', help='skip the opener search and start with this word')
    args = ap.parse_args()
    sys.stdout.reconfigure(line_buffering=True)
    os.chdir(ROOT)

    valid = {w.strip().upper() for w in open('valid_words.txt') if w.strip()}
    rows = list(csv.DictReader(open(CSV)))
    last = dt.date.fromisoformat(rows[-1]['date'])
    today = dt.date.today()

    if last >= today:
        print(f'Today\'s answer is already recorded ({rows[-1]["word"]}). Nothing to play.')
        return

    # 1. fill gaps up to yesterday
    d = last + dt.timedelta(days=1)
    if d < today:
        print(f'Answer history ends {last}; fetching {d} .. {today - dt.timedelta(days=1)} from NYT...')
    while d < today:
        w = fetch_answer(d)
        if w is not None and w not in valid:
            print(f'    note: {w} is not in valid_words.txt; recording it anyway')
            print('    (the solver cannot suggest it until valid_words.txt and word features are updated)')
        while w is None:
            w = input(f'  enter answer for {d} (#{(d - DAY0).days}) manually: ').strip().upper()
            if w not in valid:
                print('    not a valid 5-letter word, try again')
                w = None
        append_answer(d, w)
        print(f'  {d} #{(d - DAY0).days} {w}')
        d += dt.timedelta(days=1)

    # 2. build solver if needed
    if not os.path.exists(SOLVER) or os.path.getmtime(SOLVER) < os.path.getmtime(SOURCE):
        print('Building weighted_three_solver...')
        subprocess.run(['make', '-s', 'weighted_three_solver'], check=True)

    # 3. prior for today (model refit only on the first run of each month)
    os.makedirs(CACHE, exist_ok=True)
    print(f'Prior for {today} (#{(today - DAY0).days})...')
    out = subprocess.run([sys.executable, 'scripts/empirical_prior.py', '--top', '0', '--export',
                          '--model-cache', MODEL_CACHE], check=True, capture_output=True, text=True).stdout
    refit = False
    for line in out.splitlines():
        if line.startswith('Model:'):
            refit = 'refit' in line
            print('  ' + line)
        if line.startswith('Category probabilities'):
            print('  ' + line.replace('Category probabilities for next day', 'today'))

    # 4. opener: reuse if the prior is unchanged; otherwise search yesterday's best
    #    openers plus the top 20 by bound (full 300 after a refit or with no history)
    opener = args.opener.lower() if args.opener else None
    if not opener:
        digest = hashlib.sha256(open(PRIOR, 'rb').read()).hexdigest()
        try:
            cached = json.load(open(OPENER_CACHE))
        except (OSError, ValueError):
            cached = {}
        if cached.get('prior_sha256') == digest:
            opener = cached['opener']
            print(f'  opener {opener.upper()} (cached, P(<=3) {cached["p3"]})')
        else:
            full = refit or not os.path.exists(TOP_OPENERS)
            cmd = [SOLVER, '--top', '1', '--max-first', '300' if full else '20', '--save-top', TOP_OPENERS]
            if not full:
                cmd += ['--candidates', TOP_OPENERS]
            print('  searching openers' + (' (full search, monthly)...' if full else '...'))
            res = subprocess.run(cmd, check=True, capture_output=True, text=True).stdout
            row = next(l for l in res.splitlines() if l.startswith('1 '))
            opener, p3 = row.split()[1], row.split()[2]
            json.dump({'prior_sha256': digest, 'opener': opener, 'p3': p3}, open(OPENER_CACHE, 'w'))
            print(f'  opener {opener.upper()} (P(<=3) {p3})')

    # 5. play
    if os.path.exists(SOLVED):
        os.remove(SOLVED)
    subprocess.run([SOLVER, '--play', opener, '--solved-file', SOLVED], stderr=subprocess.DEVNULL)

    # 6. record
    if os.path.exists(SOLVED):
        word = open(SOLVED).read().strip().upper()
        append_answer(today, word)
        os.remove(SOLVED)
        print(f'Recorded {today}: {word}')
    else:
        print('Not solved; tomorrow\'s run will fetch today\'s answer.')


if __name__ == '__main__':
    try:
        main()
    except KeyboardInterrupt:
        print()
